# ============================================================
# FINESHEET OMNICHANNEL � TEMPLATE .env PRODUCTION
# ============================================================
# PETUNJUK:
# 1. Copy file ini ke server sebagai ".env" (tanpa .example)
# 2. Ganti semua nilai yang bertanda <GANTI_INI>
# 3. Jalankan: php artisan key:generate
# 4. Jalankan: php artisan config:cache
# ============================================================

# -- APP -----------------------------------------------------
APP_NAME=Finesheet
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.finesheet.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -- LOGGING -------------------------------------------------
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -- DATABASE (PostgreSQL) -----------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=<GANTI_INI>
DB_USERNAME=<GANTI_INI>
DB_PASSWORD=<GANTI_INI>

# -- MARKETPLACE API -----------------------------------------
SHOPEE_PARTNER_ID=<GANTI_INI>
SHOPEE_PARTNER_KEY=<GANTI_INI>

TIKTOK_APP_KEY=<GANTI_INI>
TIKTOK_APP_SECRET=<GANTI_INI>
TIKTOK_REDIRECT_URI=https://www.finesheet.id/tiktok/callback

# -- SESSION & SECURITY --------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.finesheet.id
SESSION_SECURE_COOKIE=true

SANCTUM_STATEFUL_DOMAINS=www.finesheet.id,finesheet.id

# -- QUEUE & CACHE -------------------------------------------
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# -- WEBSOCKET (Laravel Reverb) ------------------------------
REVERB_APP_ID=<GANTI_INI>
REVERB_APP_KEY=<GANTI_INI>
REVERB_APP_SECRET=<GANTI_INI>
REVERB_HOST=www.finesheet.id
REVERB_PORT=443
REVERB_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# -- MAIL (Opsional) -----------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<EMAIL_PENGIRIM>
MAIL_PASSWORD=<APP_PASSWORD_EMAIL>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<EMAIL_PENGIRIM>
MAIL_FROM_NAME="${APP_NAME}"

# -- REDIS (Opsional) ----------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -- AWS S3 (Opsional) ---------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SHOPEE URLS
SHOPEE_BASE_URL_SANDBOX=https://openplatform.sandbox.test-stable.shopee.sg
SHOPEE_BASE_URL_PRODUCTION=https://partner.shopeemobile.com
SHOPEE_REDIRECT_URI_SANDBOX=https://groggy-enjoyable-unfair.ngrok-free.dev/shopee/callback
SHOPEE_REDIRECT_URI_PRODUCTION=${APP_URL}/shopee/callback

# TIKTOK URLS
TIKTOK_OPEN_URL_SANDBOX=https://services.tiktokshop.com/open/authorize
TIKTOK_OPEN_URL_PRODUCTION=https://services.tiktokshop.com/open/authorize
TIKTOK_API_URL_SANDBOX=https://open-api.tiktokglobalshop.com
TIKTOK_API_URL_PRODUCTION=https://open-api.tiktokglobalshop.com
TIKTOK_AUTH_URL_SANDBOX=https://auth.tiktok-shops.com
TIKTOK_AUTH_URL_PRODUCTION=https://auth.tiktok-shops.com
