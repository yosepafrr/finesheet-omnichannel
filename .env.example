APP_NAME=Finesheet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# APP_URL=https://3086-103-3-220-202.ngrok-free.app 
# ASSET_URL=https://3086-103-3-220-202.ngrok-free.app 
# VITE_APP_URL=https://3086-103-3-220-202.ngrok-free.app 

# === NGROK: Aktifkan baris di bawah saat menggunakan NGROK ===
# Ganti dengan hostname ngrok tunnel vite kamu (tanpa https://)
# Contoh: abc123.ngrok-free.app
# VITE_HMR_HOST=3086-103-3-220-202.ngrok-free.app 
# VITE_HMR_PORT=443
# VITE_HMR_CLIENT_PORT=443

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# === NGROK: tambahkan domain ngrok Laravel agar Sanctum mengizinkan session ===
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1


FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME=""

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME=""

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY=
VITE_REVERB_HOST="127.0.0.1"
VITE_REVERB_PORT="8080"
VITE_REVERB_SCHEME="http"

# SHOPEE URLS
SHOPEE_BASE_URL_SANDBOX=https://openplatform.sandbox.test-stable.shopee.sg
SHOPEE_BASE_URL_PRODUCTION=https://partner.shopeemobile.com
SHOPEE_REDIRECT_URI_SANDBOX=https://groggy-enjoyable-unfair.ngrok-free.dev/shopee/callback
SHOPEE_REDIRECT_URI_PRODUCTION=${APP_URL}/shopee/callback

# TIKTOK URLS
TIKTOK_OPEN_URL_SANDBOX=https://services.tiktokshop.com/open/authorize
TIKTOK_OPEN_URL_PRODUCTION=https://services.tiktokshop.com/open/authorize
TIKTOK_API_URL_SANDBOX=https://open-api.tiktokglobalshop.com
TIKTOK_API_URL_PRODUCTION=https://open-api.tiktokglobalshop.com
TIKTOK_AUTH_URL_SANDBOX=https://auth.tiktok-shops.com
TIKTOK_AUTH_URL_PRODUCTION=https://auth.tiktok-shops.com
